            "query": "from(bucket: \"imbench\")\n  |> range(start: -24h)  // Adjust time range as needed\n  |> filter(fn: (r) => r._measurement == \"conversation\" and r._field == \"inter_conversation_time\")\n  |> map(fn: (r) => ({\n      _time: r._time,\n      inter_conv_time_bucket: int(v: int(v: r._value) / 10) * 10,  // Group inter-conversation time into 10-second buckets\n      _value: 1  // Use 1 as a count\n    }))\n  |> group(columns: [\"inter_conv_time_bucket\"])  // Group by the bucket value\n  |> sum(column: \"_value\")  // Count the number of entries per bucket\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: r._value,\n      inter_conv_time: string(v: r.inter_conv_time_bucket) + \"-\" + string(v: r.inter_conv_time_bucket + 10)  // Use bucket as range label\n    }))\n  |> keep(columns: [\"_time\", \"_value\", \"inter_conv_time\"])  // Keep only relevant columns",
